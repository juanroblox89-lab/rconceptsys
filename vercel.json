{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "BACKEND_URL" }]
    },
    "api": {
      "root": "backend/",
      "framework": "go"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
