{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "go"
    }
  },
  "crons": [
    { "path": "/api/cron/notificaciones", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
