# RConcept Systems v2 — variables de entorno (ejemplo).
# NUNCA commitear .env ni .env.local. Nunca subir claves al repo.

# Puerto y URLs de servicios (F0: web 3310, backend Go 8310)
PORT=8310
BACKEND_URL=http://localhost:8310
NEXT_PUBLIC_API_URL=http://localhost:8310

# Lista de correos administradores (separados por coma)
ADMIN_EMAILS=jestalvz@gmail.com,admin@rconcept.com

# Supabase (Proyecto fjjhopqzfbmhzxtwfnmt)
# Web (publicas):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (privadas):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_URL=

# Modo Demo: Solo se permite si NO hay SUPABASE_URL y con Store en memoria.
# Si SUPABASE_URL y RC_MODO_DEMO=1 se configuran a la vez, el backend falla por seguridad.
RC_MODO_DEMO=0
NEXT_PUBLIC_RC_DEMO=0
