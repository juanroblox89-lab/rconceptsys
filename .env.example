# RConcept Systems v2 — variables de entorno. Copiar a `.env.local` y completar.
# NUNCA commitear `.env.local` (tiene credenciales reales). Nunca subir claves al repo.

# URL base del backend Go. En local: http://localhost:8095.
# En Vercel la inyecta el binding del servicio "api" (ver vercel.json).
BACKEND_URL=http://localhost:8095

# URL pública del proyecto Supabase (Auth + REST).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública del proyecto Supabase (solo lectura/escritura según RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del proyecto Supabase para el backend (server-side).
SUPABASE_URL=

# Service role key del proyecto Supabase. Solo server-side (backend);
# jamás usar prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto interno que el proxy /api/backend/* (server-side) agrega como
# cabecera X-RC-Internal al llamar al backend. Opcional en local;
# jamás usar prefijo NEXT_PUBLIC_.
RC_INTERNAL_SECRET=

# URL pública de la web desplegada. Solo se usa para el wrapper Android
# (Capacitor `server.url`). Vacía en local = la app usa el bundle local.
# Ejemplo cuando esté desplegada: https://rsys.vercel.app
CAP_SERVER_URL=
