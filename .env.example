# RConcept Systems v2 — variables de entorno (ejemplo).
# NUNCA commitear .env ni .env.local. Nunca subir claves al repo.

# Puerto y URLs de servicios (F0: web 3310, backend Go 8310)
PORT=8310
BACKEND_URL=http://localhost:8310
NEXT_PUBLIC_API_URL=http://localhost:8310

# Lista de correos administradores (separados por coma)
ADMIN_EMAILS=jestalvz@gmail.com,admin@rconcept.com

# Supabase (Proyecto fjjhopqzfbmhzxtwfnmt)
# Web (publicas):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (privadas):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_URL=

# Modo Demo: Solo se permite si NO hay SUPABASE_URL y con Store en memoria.
# Si SUPABASE_URL y RC_MODO_DEMO=1 se configuran a la vez, el backend falla por seguridad.
RC_MODO_DEMO=0
NEXT_PUBLIC_RC_DEMO=0

# F5 · Conector de Google Drive (una sola cuenta del equipo).
# Los crea Juan en Google Cloud Console (OAuth client tipo "Web application"):
#   GOOGLE_CLIENT_ID      = ID del cliente OAuth
#   GOOGLE_CLIENT_SECRET  = secreto del cliente (solo backend, nunca en el repo)
#   GOOGLE_REDIRECT_URI   = https://<dominio>/api/drive/callback (si se deja vacío se calcula del host)
#   GOOGLE_DRIVE_CARPETA_RAIZ = id de la carpeta del Drive donde se crean las subcarpetas por tarea (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_CARPETA_RAIZ=

# F5 · Avisos push (Web Push / VAPID). Generar una vez y guardar las claves:
#   npx web-push generate-vapid-keys
# La pública también se puede exponer como NEXT_PUBLIC_VAPID_CLAVE_PUBLICA (no hace falta: el backend la sirve en /api/push/clave).
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=
VAPID_ASUNTO=mailto:juan@rconcept.com
